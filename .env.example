# Copy to .env for local development. Never commit .env.
# On Hostinger, set these in the Node.js app's environment variables, not in the repo.

# dev | production. Production turns off GraphiQL, the dev mailbox, and schema sync.
APP_ENV=dev
NODE_ENV=development

# Hostinger injects PORT at runtime. Locally this is the server port.
# Do not set PORT on Hostinger unless the panel requires it; their value must win.
PORT=3000

# Required. Production rejects the defaults below (password "superadmin", short cookie secret).
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
COOKIE_SECRET=dev-only-cookie-secret-not-for-production

# sqlite (local only) | mysql | mariadb
# On Hostinger use mariadb. Their "MySQL" database is MariaDB, and the mariadb
# driver matches it. mysql also connects, but TypeORM then reports a false schema mismatch.
DB_TYPE=sqlite
# Used when DB_TYPE is mysql or mariadb. On Hostinger use 127.0.0.1, not localhost.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=change-me
# Keep this small on shared hosting.
DB_POOL_SIZE=5
DB_LOGGING=false

# Comma-separated browser origins for the Shop API. Ignored when APP_ENV=dev.
# The admin dashboard is served by this same app, so it does not need to be listed.
CORS_ORIGINS=https://vitamin2001.in,https://www.vitamin2001.in

# Where a future storefront will live. Used in customer email links.
STOREFRONT_URL=http://localhost:3001
EMAIL_FROM="Vitamin 2001" <noreply@vitamin2001.in>

# Leave SMTP unset locally (emails are written to static/email/test-emails and /mailbox).
# In production, unset SMTP means email is silently dropped until you fill these in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# First boot only, and only while the default channel is still the stock USD channel.
DEFAULT_CURRENCY=INR
DEFAULT_LANGUAGE_CODE=en
PRICES_INCLUDE_TAX=true
APPLY_STORE_DEFAULTS=true

# Product images. On Hostinger set this to a directory outside hbuilds/, or uploads
# are deleted on the next deploy. Locally the default static/assets directory is fine.
ASSET_UPLOAD_DIR=
ASSET_URL_PREFIX=

# On Hostinger leave this false. Set true only for a deploy that adds a migration,
# then set it back to false. The public port opens before this runs.
RUN_MIGRATIONS=true
# Process the SQL job queue inside the server process (required on shared hosting).
# It starts JOB_QUEUE_START_DELAY_MS after Vendure is ready, so boot and the first
# requests are not competing with queue polling.
RUN_JOB_QUEUE_IN_SERVER=true
RUN_TASKS_IN_WORKER_ONLY=false
JOB_QUEUE_POLL_INTERVAL_MS=5000
JOB_QUEUE_START_DELAY_MS=5000

# Dummy payments let you place test orders without a gateway. Forced off in production
# unless you set this to true. Add a real gateway (for example Razorpay) before launch.
ALLOW_DUMMY_PAYMENTS=false
