{
  "name": "shop-vitamin2001",
  "version": "0.1.0",
  "private": true,
  "description": "Vendure backend for the Vitamin 2001 shop, prepared for Hostinger Node.js hosting.",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n server,dashboard -c blue,magenta \"npm run dev:server\" \"npm run dev:dashboard\"",
    "dev:server": "ts-node ./src/index.ts",
    "dev:dashboard": "vite --clearScreen false",
    "dev:worker": "ts-node ./src/index-worker.ts",
    "build": "tsc && vite build && mkdir -p dist/static/email && cp -a static/email/templates dist/static/email/templates",
    "start": "node ./dist/index.js",
    "start:worker": "node ./dist/index-worker.js",
    "migration:generate": "vendure migrate -g",
    "migration:run": "vendure migrate -r",
    "migration:revert": "vendure migrate --revert",
    "doctor": "vendure doctor"
  },
  "dependencies": {
    "@vendure/asset-server-plugin": "3.7.3",
    "@vendure/core": "3.7.3",
    "@vendure/dashboard": "3.7.3",
    "@vendure/email-plugin": "3.7.3",
    "@vendure/graphiql-plugin": "3.7.3",
    "dotenv": "^17.2.2",
    "mysql2": "^3.15.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "@vendure/cli": "3.7.3",
    "concurrently": "^9.2.1",
    "ts-node": "^10.9.2",
    "typescript": "5.8.2",
    "vite": "^7.3.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  }
}
